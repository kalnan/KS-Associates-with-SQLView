# Copy this file to .env for local development.
# On Render, set these as Environment Variables / Secrets on the web service instead.

# Provided automatically by Render when you link a managed Postgres database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# The secret admin key administrators type into the login screen.
# Generate something long and random - never reuse it elsewhere.
ADMIN_KEY=change-this-to-a-long-random-secret

# A SECOND, separate secret that unlocks the raw-SQL console (SQL View tab).
# Keep this different from ADMIN_KEY - it gates a much higher-risk feature.
SQL_ACCESS_KEY=change-this-to-a-different-long-random-secret

# Secret used to sign admin session tokens (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# Comma-separated list of origins allowed to call the API.
# Leave blank to allow any origin (fine while frontend + backend share one service).
CORS_ORIGIN=

PORT=4000
